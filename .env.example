# --- Base relationnelle : Supabase -------------------------------------------
# URL du POOLER Supavisor en mode transaction (port 6543), pas la connexion
# directe en 5432 : en serverless, chaque invocation ouvre une connexion.
# Supabase > Project Settings > Database > Connection pooling
DATABASE_URL=postgresql://postgres.<ref>:<mot_de_passe>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Base non relationnelle : Redis (Upstash) --------------------------------
# Upstash > Database > REST API. Client HTTP : pas de socket TCP à maintenir.
UPSTASH_REDIS_REST_URL=https://<votre-base>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<votre_token>

# --- Chiffrement des données sensibles au repos ------------------------------
# AES-256-GCM. Générer avec : openssl rand -base64 32
CLE_CHIFFREMENT=<32_octets_en_base64>

# --- API France Travail ------------------------------------------------------
# https://francetravail.io — souscrire à l'API "Offres d'emploi v2"
FT_CLIENT_ID=<votre_client_id>
FT_CLIENT_SECRET=<votre_client_secret>

# --- Automatisations n8n -----------------------------------------------------
# Secret partagé protégeant les endpoints internes appelés par n8n
SECRET_N8N=<chaine_aleatoire_longue>

# --- Webhook Discord ---------------------------------------------------------
# Salon dédié > Paramètres du serveur > Intégrations > Webhooks > Nouveau webhook
WEBHOOK_DISCORD=https://discord.com/api/webhooks/<id>/<jeton>

# --- Envoi de courriel transactionnel (réinitialisation de mot de passe) ------
# Brevo : https://app.brevo.com > SMTP & API > API Keys. Gratuit, 300 envois/jour.
# Brevo plutôt qu'un autre : il autorise l'envoi depuis une adresse personnelle
# VÉRIFIÉE, sans posséder de domaine — seul verrou qui bloquait un projet d'école.
# Sans ces variables, les messages partent au journal du serveur : le parcours reste
# complet et testable, et l'absence de configuration se voit au lieu d'échouer en
# silence.
BREVO_API_KEY=<votre_cle_api>
COURRIEL_EXPEDITEUR=<adresse_verifiee_chez_brevo>
COURRIEL_EXPEDITEUR_NOM=Intérimatch

# Base publique du site, pour composer les liens envoyés par courriel.
# En local, laisser vide : l'origine de la requête est utilisée.
# EN PRODUCTION, la renseigner. Derrière un proxy, l'origine de la requête peut être
# une adresse interne — le lien de réinitialisation serait alors inutilisable.
URL_PUBLIQUE=
