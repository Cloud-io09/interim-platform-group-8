{
  "name": "Intérimatch — notification de mission correspondante",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "id": "notifications-declencheur",
      "name": "Chaque jour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://VOTRE-DOMAINE/api/n8n/missions-a-notifier?heures=24",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "notifications-api",
      "name": "Missions à notifier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REMPLACER",
          "name": "Secret Intérimatch"
        }
      },
      "notes": "Le matching est rejoué à chaque appel : prévenir quelqu'un qui n'est plus conforme serait pire que ne rien envoyer."
    },
    {
      "parameters": {
        "fieldToSplitOut": "notifications",
        "options": {}
      },
      "id": "notifications-eclatement",
      "name": "Un message par personne",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "notes": "L'API renvoie un objet contenant un tableau ; Discord attend un message par destinataire. Sans alerte, ce nœud ne produit rien et la suite ne s'exécute pas : le flux ne poste jamais dans le vide."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "missions-filtre-condition",
              "leftValue": "={{ $json.discordSalonId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "missions-filtre",
      "name": "A un salon privé",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "notes": "Écarte qui n'a pas relié son compte Discord : « discordSalonId » vaut alors null. Sans ce nœud, l'appel partirait vers /channels/null/messages et échouerait à chaque exécution. La notification reste lisible dans l'application — Discord n'est qu'un relais."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://discord.com/api/v10/channels/{{ $json.discordSalonId }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{ $json.message }}"
            }
          ]
        },
        "options": {}
      },
      "id": "missions-discord",
      "name": "Poster dans le salon privé",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REMPLACER",
          "name": "Bot Discord Intérimatch"
        }
      },
      "notes": "Poste dans le salon PRIVÉ du destinataire, pas dans un salon commun. L'alerte nomme la personne, son habilitation et sa date d'échéance : un webhook unique la diffusait à tous les membres du serveur. L'identité du salon vient de l'API, le message aussi — n8n transporte, il ne décide pas."
    }
  ],
  "connections": {
    "Chaque jour": {
      "main": [
        [
          {
            "node": "Missions à notifier",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Missions à notifier": {
      "main": [
        [
          {
            "node": "Un message par personne",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Un message par personne": {
      "main": [
        [
          {
            "node": "A un salon privé",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "A un salon privé": {
      "main": [
        [
          {
            "node": "Poster dans le salon privé",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
