{
  "name": "interimatch",
  "private": true,
  "type": "module",
  "description": "InterimMatch BTP — mise en relation entreprises du BTP / intérimaires",
  "workspaces": [
    "core",
    "web",
    "ingest",
    "explo-api"
  ],
  "scripts": {
    "migrate": "npm run -w @interimatch/core migrate",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "ingest": "npm run -w @interimatch/ingest ingest --",
    "dev": "npm run -w @interimatch/web dev",
    "build": "npm run -w @interimatch/web build",
    "verifier": "npm run typecheck && npm run test",
    "coverage": "npm run coverage --workspaces --if-present",
    "fumee": "node outils/fumee-auth.mjs",
    "parcours": "node outils/parcours-complet.mjs",
    "discord": "node --env-file-if-exists=.env outils/discord-verif.mjs",
    "fumee:notifs": "node --env-file-if-exists=.env outils/fumee-notifications.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1"
  }
}
